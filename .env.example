# Copy to .env for local development. Never commit .env.
MAKARIOS_ENVIRONMENT=development
MAKARIOS_DEBUG=true
# Defaults to SQLite in makarios.db at the project root. Production sets Postgres here.
# MAKARIOS_DATABASE_URL=sqlite:///makarios.db

# Production sets these as Railway variables, never in a file (see docs/DEPLOY.md):
# MAKARIOS_ENVIRONMENT=production
# MAKARIOS_DATABASE_URL=${{Postgres.DATABASE_URL}}
# MAKARIOS_SECRET_KEY=<python3 -c "import secrets; print(secrets.token_urlsafe(32))">

# Only for running the tests against Postgres. The suite drops every table in it.
# MAKARIOS_TEST_DATABASE_URL=postgresql+psycopg://postgres:test@localhost:5433/postgres
